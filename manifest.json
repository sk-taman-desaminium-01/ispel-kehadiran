{
  "manifest_version": 3,
  "name": "Kehadiran IDME",
  "version": "1.6.1",
  "description": "Satu butang terus di halaman iSPEL: isi kehadiran murid automatik dari senarai tidak hadir yang disahkan guru kelas di Portal SKTD.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://moeispel.moe.gov.my/*",
    "https://sktd.edu.my/*",
    "https://portal.sktd.edu.my/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Kehadiran IDME",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://moeispel.moe.gov.my/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
